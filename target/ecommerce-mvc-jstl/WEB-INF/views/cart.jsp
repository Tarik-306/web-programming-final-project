<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="partials/header.jsp" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><h2>Sepet</h2><table class="table table-bordered bg-white"><tr><th>Ürün</th><th>Birim Fiyat</th><th>Adet</th><th>Ara Toplam</th><th></th></tr><c:forEach var="i" items="${sessionScope.cart}"><tr><td>${i.product.name}</td><td><fmt:formatNumber value="${i.product.price}" type="currency" currencySymbol="₺"/></td><td><form method="post" action="cart" class="d-flex"><input type="hidden" name="productId" value="${i.product.id}"><input class="form-control" type="number" name="quantity" min="1" max="${i.product.stock}" value="${i.quantity}"><button class="btn btn-sm btn-primary">Güncelle</button></form></td><td><fmt:formatNumber value="${i.subtotal}" type="currency" currencySymbol="₺"/></td><td><form method="post" action="cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${i.product.id}"><button class="btn btn-danger btn-sm">Çıkar</button></form></td></tr></c:forEach></table><h4>Genel Toplam: <fmt:formatNumber value="${total}" type="currency" currencySymbol="₺"/></h4><form method="post" action="checkout"><button class="btn btn-success">Sipariş Oluştur</button></form><%@ include file="partials/footer.jsp" %>
