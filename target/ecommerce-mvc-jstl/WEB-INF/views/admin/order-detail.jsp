<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="../partials/header.jsp" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><h2>Sipariş #${order.id}</h2><p>Müşteri: ${order.customerName}</p><p>Toplam: <fmt:formatNumber value="${order.totalAmount}" type="currency" currencySymbol="₺"/></p><form method="post" action="orders" class="mb-3"><input type="hidden" name="id" value="${order.id}"><select name="status" class="form-select w-25 d-inline"><option>Beklemede</option><option>Hazırlanıyor</option><option>Kargoya Verildi</option><option>Tamamlandı</option><option>İptal Edildi</option></select><button class="btn btn-primary">Durumu Güncelle</button></form><table class="table bg-white"><tr><th>Ürün</th><th>Adet</th><th>Birim</th><th>Ara toplam</th></tr><c:forEach var="i" items="${order.items}"><tr><td>${i.productName}</td><td>${i.quantity}</td><td><fmt:formatNumber value="${i.unitPrice}" type="currency" currencySymbol="₺"/></td><td><fmt:formatNumber value="${i.subtotal}" type="currency" currencySymbol="₺"/></td></tr></c:forEach></table><%@ include file="../partials/footer.jsp" %>
