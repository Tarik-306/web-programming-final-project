<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="../partials/header.jsp" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><h2>Ürün Yönetimi</h2><form method="post" class="card card-body mb-3"><input type="hidden" name="id" value="${product.id}"><select required class="form-select mb-2" name="categoryId"><option value="">Kategori seç</option><c:forEach var="c" items="${categories}"><option value="${c.id}" ${product.categoryId==c.id?'selected':''}>${c.name}</option></c:forEach></select><input required class="form-control mb-2" name="name" placeholder="Ürün adı" value="${product.name}"><textarea required class="form-control mb-2" name="description" placeholder="Açıklama">${product.description}</textarea><input required min="0.01" step="0.01" class="form-control mb-2" name="price" type="number" placeholder="Fiyat" value="${product.price}"><input required min="0" class="form-control mb-2" name="stock" type="number" placeholder="Stok" value="${product.stock}"><input class="form-control mb-2" name="imageUrl" placeholder="Görsel yolu / URL" value="${product.imageUrl}"><label><input type="checkbox" name="active" checked> Aktif</label><button class="btn btn-primary mt-2">Kaydet</button></form><table class="table bg-white"><tr><th>ID</th><th>Ad</th><th>Kategori</th><th>Fiyat</th><th>Stok</th><th>Durum</th><th></th></tr><c:forEach var="p" items="${products}"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.categoryName}</td><td><fmt:formatNumber value="${p.price}" type="currency" currencySymbol="₺"/></td><td>${p.stock}</td><td>${p.active?'Aktif':'Pasif'}</td><td><a class="btn btn-sm btn-warning" href="products?action=edit&id=${p.id}">Güncelle</a> <a class="btn btn-sm btn-danger" href="products?action=delete&id=${p.id}">Pasif Yap</a></td></tr></c:forEach></table><%@ include file="../partials/footer.jsp" %>
