<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="partials/header.jsp" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><h2>Siparişlerim</h2><c:if test="${not empty sessionScope.message}"><div class="alert alert-success">${sessionScope.message}</div><c:remove var="message" scope="session"/></c:if><table class="table table-striped bg-white"><tr><th>No</th><th>Tarih</th><th>Toplam</th><th>Durum</th></tr><c:forEach var="o" items="${orders}"><tr><td>#${o.id}</td><td><fmt:formatDate value="${o.orderDate}" pattern="dd.MM.yyyy HH:mm"/></td><td><fmt:formatNumber value="${o.totalAmount}" type="currency" currencySymbol="₺"/></td><td><c:choose><c:when test="${o.status eq 'Beklemede'}"><span class="badge bg-warning text-dark">${o.status}</span></c:when><c:otherwise><span class="badge bg-primary">${o.status}</span></c:otherwise></c:choose></td></tr></c:forEach></table><%@ include file="partials/footer.jsp" %>
