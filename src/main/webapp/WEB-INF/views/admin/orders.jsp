<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="../partials/header.jsp" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><h2>Sipariş Yönetimi</h2><table class="table bg-white"><tr><th>ID</th><th>Müşteri</th><th>Tarih</th><th>Toplam</th><th>Durum</th><th>Detay</th></tr><c:forEach var="o" items="${orders}"><tr><td>${o.id}</td><td>${o.customerName}</td><td><fmt:formatDate value="${o.orderDate}" pattern="dd.MM.yyyy HH:mm"/></td><td><fmt:formatNumber value="${o.totalAmount}" type="currency" currencySymbol="₺"/></td><td>${o.status}</td><td><a class="btn btn-info btn-sm" href="orders?id=${o.id}">Detay</a></td></tr></c:forEach></table><%@ include file="../partials/footer.jsp" %>
