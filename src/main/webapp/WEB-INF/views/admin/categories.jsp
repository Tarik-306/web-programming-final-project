<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ include file="../partials/header.jsp" %><h2>Kategori Yönetimi</h2><form method="post" class="card card-body mb-3"><input type="hidden" name="id" value="${category.id}"><input required class="form-control mb-2" name="name" placeholder="Kategori adı" value="${category.name}"><textarea class="form-control mb-2" name="description" placeholder="Açıklama">${category.description}</textarea><label><input type="checkbox" name="active" checked> Aktif</label><button class="btn btn-primary mt-2">Kaydet</button></form><table class="table bg-white"><tr><th>ID</th><th>Ad</th><th>Açıklama</th><th>Durum</th><th>İşlem</th></tr><c:forEach var="c" items="${categories}"><tr><td>${c.id}</td><td>${c.name}</td><td>${c.description}</td><td>${c.active?'Aktif':'Pasif'}</td><td><a class="btn btn-sm btn-warning" href="categories?action=edit&id=${c.id}">Güncelle</a> <a class="btn btn-sm btn-danger" href="categories?action=delete&id=${c.id}">Pasif Yap</a></td></tr></c:forEach></table><%@ include file="../partials/footer.jsp" %>
